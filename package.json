{
  "name": "evensdk-translator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "evenhub pack app.json dist -o even-translate.ehpk",
    "simulate": "evenhub-simulator http://localhost:5173",
    "whisper": "bash scripts/run-whisper.sh",
    "server": "tsx server/index.ts",
    "server:check": "tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@evenrealities/even_hub_sdk": "^0.0.12",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.13",
    "@evenrealities/evenhub-simulator": "^0.8.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
