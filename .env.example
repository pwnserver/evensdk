# Local dev: copy to .env.local (backend loads it automatically).
# Docker/server: copy to .env (docker compose reads it).

# Required: your Anthropic API key (translation runs on Claude).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# TRANSLATE_MODEL=claude-opus-4-8   # quality default; claude-haiku-4-5 / claude-sonnet-5 = faster
# WHISPER_URL=http://127.0.0.1:8080 # whisper-server (Mac dev). On the server: http://127.0.0.1:8081
# WHISPER_LANGUAGE=auto             # or pin a source language, e.g. en, es, zh
# PORT=8787                         # port that serves the app + /ws
